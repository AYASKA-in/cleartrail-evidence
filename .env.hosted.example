# Copy to .env.hosted with restrictive file permissions. Never commit real values.
CLEARTRAIL_ENV=production
CLEARTRAIL_PUBLIC_URL=https://evidence.example.com
CLEARTRAIL_DATABASE_URL=postgresql+psycopg://cleartrail_app:REPLACE@db.example.com/cleartrail?sslmode=verify-full
CLEARTRAIL_OIDC_ISSUER=https://identity.example.com
CLEARTRAIL_OIDC_CLIENT_ID=REPLACE
CLEARTRAIL_OIDC_CLIENT_SECRET=REPLACE
# Generate independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLEARTRAIL_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: NEW_KEY,OLD_KEY ; re-encrypt each tenant before removing OLD_KEY.
CLEARTRAIL_VAULT_KEYS=REPLACE_WITH_A_FERNET_KEY
# Enable binary evidence: set HOST=clamav and start Compose with --profile scanning.
# Leave empty for text-only uploads. A configured but unavailable scanner blocks uploads.
CLEARTRAIL_SCANNER_HOST=
CLEARTRAIL_SCANNER_PORT=3310
CLEARTRAIL_SCANNER_TIMEOUT_SECONDS=30
CLEARTRAIL_SCANNER_MAX_AGE_HOURS=72
# The worker uses workload identity only to assume customer read-only AWS roles.
# Configure that identity in your deployment, not with customer static keys here.
